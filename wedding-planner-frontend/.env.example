# API URL — update to your deployed Workers URL after running: npx wrangler deploy (backend)
VITE_API_URL=https://wedding-planner-api.YOUR_SUBDOMAIN.workers.dev/api

# For local development, use:
# VITE_API_URL=http://localhost:8000/api

# Frontend URL (used by backend for email links and Stripe redirects)
VITE_FRONTEND_URL=https://wedding-planner-frontend.YOUR_SUBDOMAIN.workers.dev

# Stripe price IDs (publishable, used to start checkout — must match the IDs
# configured on the backend via STRIPE_MONTHLY_PRICE_ID / STRIPE_LIFETIME_PRICE_ID)
VITE_STRIPE_MONTHLY_PRICE_ID=price_...
VITE_STRIPE_LIFETIME_PRICE_ID=price_...
